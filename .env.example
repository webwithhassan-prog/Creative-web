# PostgreSQL connection string (Neon, Supabase, Railway, or any Postgres host)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Long random string used to sign admin session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Used once by `npm run db:seed` to create the admin login.
ADMIN_EMAIL="admin@creativedyes.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Admin"
