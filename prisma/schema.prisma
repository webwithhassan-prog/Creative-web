generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartyType {
  SUPPLIER
  CUSTOMER
}

enum BalanceSide {
  DEBIT
  CREDIT
}

enum PaymentDirection {
  IN
  OUT
}

enum InvoiceKind {
  NORMAL
  RETURN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Company {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  logo      String?  @db.Text
  gstin     String?
  defaultTaxRate Decimal @default(18) @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parties          Party[]
  products         Product[]
  purchaseInvoices PurchaseInvoice[]
  saleInvoices     SaleInvoice[]
  payments         Payment[]
  auditLogs        AuditLog[]
}

model Party {
  id                 String      @id @default(cuid())
  companyId          String
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  type               PartyType
  phone              String?
  email              String?
  address            String?
  gstin              String?
  invoicePrefix      String?
  openingBalance     Decimal     @default(0) @db.Decimal(14, 2)
  openingBalanceSide BalanceSide @default(DEBIT)
  openingBalanceDate DateTime    @default(now())
  notes              String?
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  purchaseInvoices PurchaseInvoice[]
  saleInvoices     SaleInvoice[]
  payments         Payment[]

  @@index([companyId, type])
}

model Product {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  sku              String?
  unit             String   @default("kg")
  currentStock     Decimal  @default(0) @db.Decimal(14, 3)
  reorderLevel     Decimal  @default(0) @db.Decimal(14, 3)
  lastPurchaseRate Decimal? @db.Decimal(14, 2)
  lastSaleRate     Decimal? @db.Decimal(14, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  @@unique([companyId, sku])
  @@index([companyId])
}

model PurchaseInvoice {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceNo   String
  date        DateTime
  partyId     String
  party       Party          @relation(fields: [partyId], references: [id])
  items       PurchaseItem[]
  kind        InvoiceKind    @default(NORMAL)
  subtotal    Decimal        @db.Decimal(14, 2)
  taxRate     Decimal?       @db.Decimal(5, 2)
  taxAmount   Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount Decimal        @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime       @default(now())

  @@unique([companyId, invoiceNo])
  @@index([companyId, date])
  @@index([partyId])
}

model PurchaseItem {
  id                String          @id @default(cuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id])
  description       String?
  quantity          Decimal?        @db.Decimal(14, 3)
  rate              Decimal?        @db.Decimal(14, 2)
  amount            Decimal         @db.Decimal(14, 2)

  @@index([productId])
}

model SaleInvoice {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceNo   String
  date        DateTime
  partyId     String
  party       Party      @relation(fields: [partyId], references: [id])
  items       SaleItem[]
  kind        InvoiceKind @default(NORMAL)
  subtotal    Decimal    @db.Decimal(14, 2)
  taxRate     Decimal?   @db.Decimal(5, 2)
  taxAmount   Decimal    @default(0) @db.Decimal(14, 2)
  totalAmount Decimal    @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime   @default(now())

  @@unique([companyId, invoiceNo])
  @@index([companyId, date])
  @@index([partyId])
}

model SaleItem {
  id            String      @id @default(cuid())
  saleInvoiceId String
  saleInvoice   SaleInvoice @relation(fields: [saleInvoiceId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  description   String?
  quantity      Decimal?    @db.Decimal(14, 3)
  rate          Decimal?    @db.Decimal(14, 2)
  amount        Decimal     @db.Decimal(14, 2)

  @@index([productId])
}

model Payment {
  id        String           @id @default(cuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party            @relation(fields: [partyId], references: [id])
  date      DateTime
  amount    Decimal          @db.Decimal(14, 2)
  direction PaymentDirection
  method    String           @default("Cash")
  reference String?
  notes     String?
  createdAt DateTime         @default(now())

  @@index([companyId, date])
  @@index([partyId])
}

model AuditLog {
  id         String      @id @default(cuid())
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorEmail String
  actorName  String
  action     AuditAction
  entityType String
  summary    String
  createdAt  DateTime    @default(now())

  @@index([companyId, createdAt])
}
