generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartyType {
  SUPPLIER
  CUSTOMER
}

enum BalanceSide {
  DEBIT
  CREDIT
}

enum PaymentDirection {
  IN
  OUT
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Party {
  id                 String      @id @default(cuid())
  name               String
  type               PartyType
  phone              String?
  email              String?
  address            String?
  openingBalance     Decimal     @default(0) @db.Decimal(14, 2)
  openingBalanceSide BalanceSide @default(DEBIT)
  openingBalanceDate DateTime    @default(now())
  notes              String?
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  purchaseInvoices PurchaseInvoice[]
  saleInvoices     SaleInvoice[]
  payments         Payment[]

  @@index([type])
}

model Product {
  id               String   @id @default(cuid())
  name             String
  sku              String?  @unique
  unit             String   @default("kg")
  currentStock     Decimal  @default(0) @db.Decimal(14, 3)
  reorderLevel     Decimal  @default(0) @db.Decimal(14, 3)
  lastPurchaseRate Decimal? @db.Decimal(14, 2)
  lastSaleRate     Decimal? @db.Decimal(14, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
}

model PurchaseInvoice {
  id          String         @id @default(cuid())
  invoiceNo   String         @unique
  date        DateTime
  partyId     String
  party       Party          @relation(fields: [partyId], references: [id])
  items       PurchaseItem[]
  totalAmount Decimal        @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime       @default(now())

  @@index([partyId])
}

model PurchaseItem {
  id                String          @id @default(cuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Decimal         @db.Decimal(14, 3)
  rate              Decimal         @db.Decimal(14, 2)
  amount            Decimal         @db.Decimal(14, 2)

  @@index([productId])
}

model SaleInvoice {
  id          String     @id @default(cuid())
  invoiceNo   String     @unique
  date        DateTime
  partyId     String
  party       Party      @relation(fields: [partyId], references: [id])
  items       SaleItem[]
  totalAmount Decimal    @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime   @default(now())

  @@index([partyId])
}

model SaleItem {
  id            String      @id @default(cuid())
  saleInvoiceId String
  saleInvoice   SaleInvoice @relation(fields: [saleInvoiceId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Decimal     @db.Decimal(14, 3)
  rate          Decimal     @db.Decimal(14, 2)
  amount        Decimal     @db.Decimal(14, 2)

  @@index([productId])
}

model Payment {
  id        String           @id @default(cuid())
  partyId   String
  party     Party            @relation(fields: [partyId], references: [id])
  date      DateTime
  amount    Decimal          @db.Decimal(14, 2)
  direction PaymentDirection
  method    String           @default("Cash")
  reference String?
  notes     String?
  createdAt DateTime         @default(now())

  @@index([partyId])
}
